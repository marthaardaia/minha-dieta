generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  ingredients      Ingredient[]
  weeklyMenus      WeeklyMenu[]
  waterLogs        WaterLog[]
  mealLogs         MealLog[]
  shoppingItems    ShoppingItem[]
  weightLogs       WeightLog[]
  favoriteRecipes  FavoriteRecipe[]
}

model Ingredient {
  id          Int      @id @default(autoincrement())
  name        String   
  category    String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      Int      @default(1)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model WeeklyMenu {
  id        Int      @id @default(autoincrement())
  startDate DateTime
  endDate   DateTime
  meals     WeeklyMeal[]
  createdAt DateTime @default(now())

  userId    Int      @default(1)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WeeklyMeal {
  id           Int      @id @default(autoincrement())
  menuId       Int
  menu         WeeklyMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  mealType     String
  recipeText   String
  createdAt    DateTime @default(now())
}

model WaterLog {
  id            Int      @id @default(autoincrement())
  date          String
  timeSlot      String
  consumed      Boolean  @default(false)
  justification String?
  createdAt     DateTime @default(now())

  userId        Int      @default(1)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, timeSlot])
}

model MealLog {
  id            Int      @id @default(autoincrement())
  date          String
  mealType      String
  consumed      Boolean  @default(false)
  justification String?
  createdAt     DateTime @default(now())

  userId        Int      @default(1)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, mealType])
}

model ShoppingItem {
  id          Int      @id @default(autoincrement())
  name        String
  isBought    Boolean  @default(false)
  createdAt   DateTime @default(now())

  userId      Int      @default(1)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WeightLog {
  id          Int      @id @default(autoincrement())
  date        String   
  weight      Float
  createdAt   DateTime @default(now())

  userId      Int      @default(1)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model FavoriteRecipe {
  id          Int      @id @default(autoincrement())
  name        String
  mealType    String
  recipeText  String
  createdAt   DateTime @default(now())

  userId      Int      @default(1)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
